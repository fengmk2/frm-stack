{
  "extends": "@yourcompany/configs/tsconfig.node",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "paths": {
      "#*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
